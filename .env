# ---- Storage ----
# Force tasks.json in project root
TODO_PATH=tasks.json
TODO_BACKUP_PATH=tasks.json.bak

# Or, if you want global storage in ~/.todo/, comment the above and use:
# TODO_PATH=$HOME/.todo/tasks.json
# TODO_BACKUP_PATH=$HOME/.todo/tasks.json.bak

# ---- UI/Display ----
# Disable fzf integration
TODO_NO_FZF=false
# Enable terminal UI mode
TODO_TUI=false
# TUI theme (dark or light)
TODO_TUI_THEME=dark

# ---- Sorting & Defaults ----
# Sorting order: id | due | priority | text
TODO_SORT=id
# Output format: text | json | table
TODO_OUTPUT=text
# Default priority: low | medium | high
TODO_DEFAULT_PRIORITY=medium

# ---- FZF Arguments ----
TODO_FZF_ARGS=--prompt='Task> '

# ---- Limits ----
TODO_MAX_TASKS=1000
